# ===================================================
# ShiftFlow Workforce Management - Environment Configuration
# ===================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection
# Local Development (SQLite zero-dependency persistent storage):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shiftflow?schema=public"

# JWT & Cookie Authentication Secrets (Change in Production!)
JWT_SECRET=shiftflow-wfm-jwt-production-secret-key-at-least-32-chars-long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=shiftflow-wfm-cookie-secret-key-salt-2026

# Registration Invite Validation Codes
MANAGER_INVITE_CODES=MGR-APEX-2026,SHIFTFLOW-MGR,APEX-EXEC
EMPLOYEE_INVITE_CODES=APEX-STAFF-2026,SHIFTFLOW-EMP,APEX-CARE

# Frontend CORS Origin
CLIENT_URL=http://localhost:3000

